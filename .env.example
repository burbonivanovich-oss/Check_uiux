# Browserbase MCP — required for cloud browser audits with proxy / RU geo
# Sign up at https://browserbase.com, then copy keys from Settings → API Keys
BROWSERBASE_API_KEY=

# Browserbase project ID — Settings → Projects → copy the project's UUID
BROWSERBASE_PROJECT_ID=

# Stagehand (used by Browserbase MCP) defaults to Gemini.
# Get a key at https://aistudio.google.com/app/apikey (free tier is enough for audits).
# To use a different model, pass --modelName and --modelApiKey to the MCP server in .mcp.json.
GEMINI_API_KEY=
